# Primary connection string. Prefer a read-only role.
# postgres://<user>:<password>@<host>:5432/<database>?sslmode=verify-full
DATABASE_URL=

# Alternative: discrete connection params (used if DATABASE_URL is unset)
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=verify-full

# MCP transport: "stdio" (default, local) or "http" (remote/hosted)
MCP_TRANSPORT=stdio
# Port for the http transport
MCP_HTTP_PORT=3000

# Comma-separated schema allowlist. Empty = all schemas except system schemas.
PG_MCP_ALLOWED_SCHEMAS=

# Comma-separated table denylist, schema-qualified (e.g. public.users_secret).
PG_MCP_DENIED_TABLES=

# Set to "true" to enable the gated run_write_query tool. Defaults to read-only.
PG_MCP_ENABLE_WRITES=false

# Per-query guardrails
PG_MCP_STATEMENT_TIMEOUT_MS=5000
PG_MCP_MAX_ROWS=1000
